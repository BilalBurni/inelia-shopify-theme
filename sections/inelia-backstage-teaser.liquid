{% comment %}
  Inelia Records — BackStage Teaser

  A single locked panel that stands in for content which lives inside
  BackStage rather than on the storefront.

  Built for the artist "Singles" rows. The monthly singles are not Shopify
  products at all — they are files in Sky Pilot, delivered through the
  member's own downloads library. So there is no collection to render here.
  Rather than leave the row empty, this panel says where the singles live
  and sends the visitor to the right place for their state:

    signed in  -> the members area
    signed out -> join, or log in

  Sky Pilot's download URLs are built per member and per order, so the
  theme cannot link to a folder directly. The members area handles that
  hand-off; this section only needs to get people there.

  Text settings accept an {artist} token, replaced with the current
  artist's name — e.g. "New {artist} singles land inside BackStage…".
{% endcomment %}

{%- liquid
  # Metaobject fields are only readable inside a `for` loop on this store.
  assign artist_handle = page.handle
  if metaobject != blank
    assign artist_handle = metaobject.system.handle
  endif

  assign artist_name = ''
  if artist_handle != blank
    for artist in shop.metaobjects.artist.values
      if artist.system.handle == artist_handle
        assign artist_name = artist.name
        break
      endif
    endfor
  endif

  assign teaser_eyebrow = section.settings.eyebrow | replace: '{artist}', artist_name
  assign teaser_heading = section.settings.heading | replace: '{artist}', artist_name
  assign teaser_subheading = section.settings.subheading | replace: '{artist}', artist_name
  assign teaser_text = section.settings.text | replace: '{artist}', artist_name
-%}

<div class="inelia-section inelia-section--{{ section.settings.background }}">
  <div class="inelia-section-head inelia-reveal">
    {%- if teaser_eyebrow != blank -%}
      <span class="inelia-eyebrow">{{ teaser_eyebrow }}</span>
    {%- endif -%}
    {%- if teaser_heading != blank -%}
      <h2>{{ teaser_heading }}</h2>
    {%- endif -%}
    {%- if teaser_subheading != blank -%}
      <p>{{ teaser_subheading }}</p>
    {%- endif -%}
    <div class="inelia-divider"></div>
  </div>

  <div class="inelia-members__locked inelia-reveal" style="max-width: 640px; margin-left: auto; margin-right: auto;">
    {%- comment -%}
      .inelia-members__locked-icon only sets `color`, so the stroke has to
      inherit it — without stroke="currentColor" the icon renders invisible
      and leaves a gap above the text.
    {%- endcomment -%}
    <span class="inelia-members__locked-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="5" y="11" width="14" height="9" rx="1"/>
        {%- if customer -%}
          {%- comment -%} Open shackle for signed-in members. {%- endcomment -%}
          <path d="M8 11V7a4 4 0 0 1 8 0"/>
        {%- else -%}
          <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        {%- endif -%}
      </svg>
    </span>

    {%- if teaser_text != blank -%}
      <p>{{ teaser_text }}</p>
    {%- endif -%}

    <div class="inelia-locked__actions">
      {%- if customer -%}
        {%- if section.settings.member_cta_label != blank and section.settings.member_link != blank -%}
          <a class="inelia-btn inelia-btn--gold" href="{{ section.settings.member_link }}">
            {{- section.settings.member_cta_label -}}
          </a>
        {%- endif -%}
      {%- else -%}
        {%- if section.settings.join_label != blank and section.settings.join_link != blank -%}
          <a class="inelia-btn inelia-btn--gold" href="{{ section.settings.join_link }}">
            {{- section.settings.join_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.login_label != blank -%}
          <a class="inelia-btn inelia-btn--dark" href="{{ routes.account_login_url }}">
            {{- section.settings.login_label -}}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Inelia BackStage Teaser",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "One Song at a Time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Singles"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Panel text",
      "info": "{artist} is replaced with the artist's name on an artist page.",
      "default": "New singles land inside BackStage every month, long before they reach the public."
    },
    {
      "type": "header",
      "content": "Signed-in members"
    },
    {
      "type": "text",
      "id": "member_cta_label",
      "label": "Member button label",
      "default": "Enter BackStage"
    },
    {
      "type": "url",
      "id": "member_link",
      "label": "Member button link",
      "info": "The members area. Keep it Appstle-protected so only active members get in."
    },
    {
      "type": "header",
      "content": "Logged-out visitors"
    },
    {
      "type": "text",
      "id": "join_label",
      "label": "Join button label",
      "default": "Join BackStage"
    },
    {
      "type": "url",
      "id": "join_link",
      "label": "Join button link"
    },
    {
      "type": "text",
      "id": "login_label",
      "label": "Log in button label",
      "default": "Log In"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "ivory", "label": "Soft ivory" }
      ],
      "default": "ivory"
    }
  ],
  "presets": [
    {
      "name": "Inelia BackStage Teaser"
    }
  ]
}
{% endschema %}
