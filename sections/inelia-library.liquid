{%- comment -%}
  Inelia Records — Library
  Lists ALL `release` metaobjects, newest first, each linking to its product
  page (or Sky Pilot download url). Reads entirely from metaobjects, so a new
  release entry appears here automatically.

  Metaobject fields are only readable inside a `{% for %}` loop, and the
  `sort` filter empties the lazy collection — so we sort manually and render
  through a nested lookup. Card art falls back to the product's featured
  image when `cover_art` is unset.
{%- endcomment -%}

{%- liquid
  assign keys = ''
  for r in shop.metaobjects.release.values
    assign d = r.release_date | date: '%Y%m%d'
    assign entry = d | append: '~' | append: r.system.handle
    if forloop.first
      assign keys = entry
    else
      assign keys = keys | append: ',' | append: entry
    endif
  endfor
  assign ordered = keys | split: ',' | sort | reverse
  assign total = shop.metaobjects.release.values.size
-%}

<div class="inelia-section inelia-section--{{ section.settings.background }}">
  <div class="inelia-section-head inelia-reveal">
    {%- if section.settings.eyebrow != blank -%}
      <span class="inelia-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="inelia-divider"></div>
  </div>

  <div class="inelia-products__grid inelia-reveal">
    {%- if total > 0 -%}
      {%- for key in ordered -%}
        {%- assign khandle = key | split: '~' | last -%}
        {%- for r in shop.metaobjects.release.values -%}
          {%- if r.system.handle == khandle -%}
            {%- liquid
              assign c_artist = r.artist.value.name
              assign c_product = r.product.value
              assign c_cover = r.cover_art.value
              assign c_img = c_cover
              if c_img == blank and c_product != blank
                assign c_img = c_product.featured_image
              endif
              assign c_url = c_product.url | default: r.sky_pilot_url | default: '#'
            -%}
            <a class="inelia-product-card" href="{{ c_url }}">
              <div class="inelia-product-card__art">
                {%- if c_img != blank -%}
                  {{
                    c_img
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      alt: r.title
                  }}
                {%- endif -%}
              </div>
              <h3>{{ r.title }}</h3>
              {%- if c_artist != blank -%}
                <p>{{ c_artist }}</p>
              {%- endif -%}
              {%- if c_product != blank -%}
                <span class="inelia-price">
                  {%- if c_product.price_varies -%}
                    {{ 'products.product.price.from_price_html' | t: price: c_product.price_min | money }}
                  {%- else -%}
                    {{ c_product.price | money }}
                  {%- endif -%}
                </span>
              {%- endif -%}
            </a>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      <p style="grid-column: 1 / -1; text-align: center;">No releases yet.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Inelia Library",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Whole Catalogue"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Library"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every release, in one place — newest first."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "ivory", "label": "Soft ivory" }
      ],
      "default": "ivory"
    }
  ],
  "presets": [
    {
      "name": "Inelia Library"
    }
  ]
}
{% endschema %}
